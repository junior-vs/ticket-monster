COMPOSE_PROJECT_NAME=ticketmonster-platform
COMPOSE_NETWORK_NAME=ticketmonster-platform

POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_CONTAINER_NAME=ticketmonster-postgres
POSTGRES_USER=ticketmonster_admin
POSTGRES_PASSWORD=ticketmonster_admin
POSTGRES_DB=ticketmonster_admin
POSTGRES_PORT=5432

REDIS_IMAGE=redis:7.2-alpine
REDIS_CONTAINER_NAME=ticketmonster-redis
REDIS_PORT=6379

KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.0
KEYCLOAK_CONTAINER_NAME=ticketmonster-keycloak
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8081

KAFKA_IMAGE=bitnamilegacy/kafka:3.8.0
KAFKA_CONTAINER_NAME=ticketmonster-kafka
KAFKA_INIT_CONTAINER_NAME=ticketmonster-kafka-init
KAFKA_PORT=9092

OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.111.0
OTEL_COLLECTOR_CONTAINER_NAME=ticketmonster-otel-collector
OTEL_COLLECTOR_GRPC_PORT=4317
OTEL_COLLECTOR_HTTP_PORT=4318
OTEL_COLLECTOR_METRICS_PORT=8889

PROMETHEUS_IMAGE=prom/prometheus:v2.55.0
PROMETHEUS_CONTAINER_NAME=ticketmonster-prometheus
PROMETHEUS_PORT=9090

LOKI_IMAGE=grafana/loki:3.2.1
LOKI_CONTAINER_NAME=ticketmonster-loki
LOKI_PORT=3100

TEMPO_IMAGE=grafana/tempo:2.6.0
TEMPO_CONTAINER_NAME=ticketmonster-tempo
TEMPO_PORT=3200
TEMPO_OTLP_PORT=4319

GRAFANA_IMAGE=grafana/grafana:11.2.0
GRAFANA_CONTAINER_NAME=ticketmonster-grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3000
GF_AUTH_ANONYMOUS_ENABLED=true
GF_AUTH_ANONYMOUS_ORG_ROLE=Viewer